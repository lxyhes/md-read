{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨阅 Moyue",
  "version": "0.1.0",
  "identifier": "com.moyue.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "墨阅 · Moyue Reader",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#eef3f2",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: http: https:; media-src 'self' asset: http://asset.localhost blob: data: http: https:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http: https:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/moyue-simple/icon.ico",
      "icons/moyue-simple/icon.icns",
      "icons/moyue-simple/icon.png"
    ],
    "targets": "all",
    "resources": [],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
