{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨阅 Moyue",
  "version": "0.1.0",
  "identifier": "com.moyue.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "墨阅 · Moyue Reader",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": "all",
    "resources": [],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
